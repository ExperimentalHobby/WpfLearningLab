    <PackageReference Include="System.Composition.Hosting" Version="9.0.0" />
    <PackageReference Include="System.Composition.TypedParts" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Contracts\PluginNoteApp.Contracts.csproj" />
  </ItemGroup>

</Project>
