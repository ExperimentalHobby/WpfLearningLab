<Window x:Class="GameOfLife.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameOfLife"
        mc:Ignorable="d"
        Title="ライフゲーム" Height="640" Width="700">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="再生/一時停止" Padding="8,4" Margin="0,0,4,0"
                    Command="{Binding PlayPauseCommand}"
                    AutomationProperties.AutomationId="PlayPauseButton"/>
            <Button Content="リセット" Padding="8,4" Margin="0,0,16,0"
                    Command="{Binding ResetCommand}"
                    AutomationProperties.AutomationId="ResetButton"/>

            <TextBlock Text="速度(ms):" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Slider Width="120" Minimum="50" Maximum="2000" VerticalAlignment="Center" Margin="0,0,16,0"
                    Value="{Binding IntervalMilliseconds}"
                    AutomationProperties.AutomationId="IntervalSlider"/>

            <TextBlock Text="世代: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Generation}" VerticalAlignment="Center" FontWeight="Bold"
                       AutomationProperties.AutomationId="GenerationText"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="White">
            <Canvas x:Name="GridCanvas" MouseLeftButtonDown="GridCanvas_MouseLeftButtonDown"
                    AutomationProperties.AutomationId="GridCanvas"/>
        </Border>
    </Grid>
</Window>
