<Window x:Class="MiniCodeEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniCodeEditor"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:conv="clr-namespace:MiniCodeEditor.Converters"
        mc:Ignorable="d"
        Title="簡易コードエディタ" Height="560" Width="800">
    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ファイル操作 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="新規" Padding="10,4" Margin="0,0,8,0"
                    Command="{Binding NewCommand}"
                    AutomationProperties.AutomationId="NewButton"/>
            <Button Content="開く..." Padding="10,4" Margin="0,0,8,0"
                    Command="{Binding OpenCommand}"
                    AutomationProperties.AutomationId="OpenButton"/>
            <Button Content="保存" Padding="10,4" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.AutomationId="SaveButton"/>
            <Button Content="名前を付けて保存..." Padding="10,4"
                    Command="{Binding SaveAsCommand}"
                    AutomationProperties.AutomationId="SaveAsButton"/>
        </StackPanel>

        <!-- エディタオプション -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="行番号表示" Margin="0,0,16,0" VerticalAlignment="Center"
                      IsChecked="{Binding ShowLineNumbers}"
                      AutomationProperties.AutomationId="ShowLineNumbersCheckBox"/>
            <CheckBox Content="折り返し" VerticalAlignment="Center"
                      IsChecked="{Binding IsWordWrapEnabled}"
                      AutomationProperties.AutomationId="WordWrapCheckBox"/>
        </StackPanel>

        <!-- エラー表示 -->
        <TextBlock Grid.Row="2" Margin="0,0,0,8" Foreground="#C62828" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                   AutomationProperties.AutomationId="ErrorMessageText"/>

        <!-- コードエディタ本体(AvalonEdit) -->
        <avalonedit:TextEditor x:Name="Editor" Grid.Row="3"
                                FontFamily="Consolas" FontSize="14"
                                ShowLineNumbers="{Binding ShowLineNumbers}"
                                WordWrap="{Binding IsWordWrapEnabled}"
                                AutomationProperties.AutomationId="CodeEditor"/>

        <!-- ステータスバー -->
        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="Gray"
                   Text="{Binding CurrentFilePath, TargetNullValue=(無題)}"
                   AutomationProperties.AutomationId="CurrentFilePathTextBlock"/>
    </Grid>
</Window>
