<Window x:Class="RockPaperScissors.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RockPaperScissors"
        mc:Ignorable="d"
        Title="じゃんけんゲーム" Height="380" Width="360" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="じゃんけんゲーム" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Button x:Name="RockButton" Content="グー" Tag="Rock" Click="HandButton_Click"
                    FontSize="16" Padding="16,8" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="RockButton"/>
            <Button x:Name="ScissorsButton" Content="チョキ" Tag="Scissors" Click="HandButton_Click"
                    FontSize="16" Padding="16,8" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="ScissorsButton"/>
            <Button x:Name="PaperButton" Content="パー" Tag="Paper" Click="HandButton_Click"
                    FontSize="16" Padding="16,8"
                    AutomationProperties.AutomationId="PaperButton"/>
        </StackPanel>

        <TextBlock x:Name="PlayerHandTextBlock" Text="あなた: -" FontSize="16" HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="PlayerHandTextBlock"/>
        <TextBlock x:Name="CpuHandTextBlock" Text="CPU: -" FontSize="16" HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="CpuHandTextBlock"/>
        <TextBlock x:Name="ResultTextBlock" Text="手を選んでください" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,8,0,16"
                   AutomationProperties.AutomationId="ResultTextBlock"/>

        <TextBlock x:Name="ScoreTextBlock" Text="勝ち:0　負け:0　あいこ:0" HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="ScoreTextBlock"/>
        <TextBlock x:Name="StreakTextBlock" Text="連勝: 0" HorizontalAlignment="Center" Margin="0,4,0,16"
                   AutomationProperties.AutomationId="StreakTextBlock"/>

        <Button x:Name="ResetButton" Content="リセット" Click="ResetButton_Click"
                Padding="12,4" HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ResetButton"/>
    </StackPanel>
</Window>
