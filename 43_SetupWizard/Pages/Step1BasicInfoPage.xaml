<Page x:Class="SetupWizard.Pages.Step1BasicInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Step1BasicInfoPage">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Step 1 / 3 : 基本情報" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <TextBlock Grid.Row="1" Text="氏名" Margin="0,0,0,4" />
        <TextBox Grid.Row="2" x:Name="NameTextBox" AutomationProperties.AutomationId="NameTextBox" Margin="0,0,0,12" />

        <TextBlock Grid.Row="3" Text="メールアドレス" Margin="0,0,0,4" />
        <TextBox Grid.Row="4" x:Name="EmailTextBox" AutomationProperties.AutomationId="EmailTextBox" Margin="0,0,0,12" />

        <TextBlock Grid.Row="5" x:Name="ErrorTextBlock" AutomationProperties.AutomationId="ErrorTextBlock" Foreground="Red" TextWrapping="Wrap" VerticalAlignment="Top" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="NextButton" AutomationProperties.AutomationId="NextButton" Content="次へ" Width="80" Click="NextButton_Click" />
        </StackPanel>
    </Grid>
</Page>
