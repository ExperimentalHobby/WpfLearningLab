<Page x:Class="SetupWizard.Pages.Step3ConfirmPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  Title="Step3ConfirmPage">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Step 3 / 3 : 確認" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

		<TextBlock Grid.Row="1" x:Name="SummaryTextBlock" AutomationProperties.AutomationId="SummaryTextBlock" TextWrapping="Wrap" VerticalAlignment="Top" />

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Content="キャンセル" Width="80" Margin="0,0,8,0" Click="CancelButton_Click" />
			<Button x:Name="BackButton" AutomationProperties.AutomationId="BackButton" Content="戻る" Width="80" Margin="0,0,8,0" Click="BackButton_Click" />
			<Button x:Name="CompleteButton" AutomationProperties.AutomationId="CompleteButton" Content="完了" Width="80" Click="CompleteButton_Click" />
		</StackPanel>
	</Grid>
</Page>
