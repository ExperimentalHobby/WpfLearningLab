<Project>

  <!--
    各プロジェクトの最終生成物(bin)をプロジェクトフォルダ配下ではなく、
    リポジトリルートの bin/<プロジェクト名>/ 配下にまとめて出力する。
    中間生成物(obj)は従来通り各プロジェクトフォルダ配下に残す。
  -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>

  <!--
    .NETアナライザーを全プロジェクトで有効化する(#121)。
    導入時点でリポジトリ全体をビルドし、新規警告が0件であることを確認済み。
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

</Project>
