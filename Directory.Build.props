<Project>

  <!--
    各プロジェクトの最終生成物(bin)をプロジェクトフォルダ配下ではなく、
    リポジトリルートの bin/<プロジェクト名>/ 配下にまとめて出力する。
    中間生成物(obj)は従来通り各プロジェクトフォルダ配下に残す。
  -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>

  <!--
    全プロジェクト共通のプロパティを集約する(#121)。
    Nullable/ImplicitUsingsは全121プロジェクトで同一設定のため無条件に適用する。
    TargetFrameworkは既定値のみを示し、非WPF系プロジェクト(ASP.NET Core等)や
    Windows SDKバージョン指定が必要なプロジェクトは各.csprojで個別に上書きする。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    .NETアナライザーを全プロジェクトで有効化する(#121)。
    導入時点でリポジトリ全体をビルドし、新規警告が0件であることを確認済み。
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    公開/internalメンバーへのXMLドキュメントコメント記載を全プロジェクトで強制する(#121)。
    導入前に既存の欠落・誤り(フェーズ0〜2)をすべて解消し、新規警告が0件であることを確認済み。
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
