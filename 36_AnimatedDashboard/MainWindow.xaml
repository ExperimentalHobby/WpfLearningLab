<Window x:Class="AnimatedDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimatedDashboard"
        xmlns:views="clr-namespace:AnimatedDashboard.Views"
        mc:Ignorable="d"
        Title="アニメーションダッシュボード" Height="420" Width="640">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="更新" Command="{Binding RefreshCommand}" Padding="12,4" Margin="0,0,16,0"
                    AutomationProperties.AutomationId="RefreshButton"/>
            <TextBlock Text="イージング:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding EasingTypes}" SelectedItem="{Binding SelectedEasing}" Width="120"
                      AutomationProperties.AutomationId="EasingComboBox"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Metrics}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:KpiCard MetricName="{Binding Name}" Unit="{Binding Unit}" TargetValue="{Binding Value}"
                                   Easing="{Binding DataContext.SelectedEasing, RelativeSource={RelativeSource AncestorType=Window}}"
                                   AutomationProperties.AutomationId="{Binding Name}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
