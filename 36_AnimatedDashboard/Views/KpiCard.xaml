<UserControl x:Class="AnimatedDashboard.Views.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="180" d:DesignHeight="100">
    <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="6" Padding="16" Margin="8" MinWidth="160">
        <StackPanel>
            <TextBlock Text="{Binding MetricName, ElementName=Root}" FontSize="14" Foreground="Gray"/>
            <TextBlock FontSize="28" FontWeight="Bold" Foreground="#1565C0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0:0.##}{1}">
                        <Binding Path="DisplayValue" ElementName="Root"/>
                        <Binding Path="Unit" ElementName="Root"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
