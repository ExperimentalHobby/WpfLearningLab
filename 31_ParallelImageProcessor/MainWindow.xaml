<Window x:Class="ParallelImageProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParallelImageProcessor"
        mc:Ignorable="d"
        Title="並列画像バッチ処理ツール" Height="420" Width="640">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- フォルダ選択 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="処理対象フォルダ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Grid.Column="1" Text="{Binding SourceFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="SourceFolderText"/>
            <Button Grid.Column="2" Content="選択..." Padding="8,4" Command="{Binding SelectSourceFolderCommand}"
                    AutomationProperties.AutomationId="SelectSourceFolderButton"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="保存先フォルダ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Grid.Column="1" Text="{Binding DestinationFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="DestinationFolderText"/>
            <Button Grid.Column="2" Content="選択..." Padding="8,4" Command="{Binding SelectDestinationFolderCommand}"
                    AutomationProperties.AutomationId="SelectDestinationFolderButton"/>
        </Grid>

        <!-- 処理オプション -->
        <GroupBox Grid.Row="2" Header="処理オプション" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="リサイズする" VerticalAlignment="Center" Margin="0,0,16,0"
                              IsChecked="{Binding ResizeEnabled}"
                              AutomationProperties.AutomationId="ResizeEnabledCheckBox"/>
                    <TextBlock Text="幅:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="60" VerticalContentAlignment="Center" Margin="0,0,8,0"
                             Text="{Binding TargetWidth, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="TargetWidthTextBox"/>
                    <TextBlock Text="高さ:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Width="60" VerticalContentAlignment="Center"
                             Text="{Binding TargetHeight, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="TargetHeightTextBox"/>
                </StackPanel>
                <CheckBox Content="グレースケール化する" IsChecked="{Binding GrayscaleEnabled}"
                          AutomationProperties.AutomationId="GrayscaleEnabledCheckBox"/>
            </StackPanel>
        </GroupBox>

        <!-- 実行ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="開始" Padding="12,4" Margin="0,0,8,0" Command="{Binding StartCommand}"
                    AutomationProperties.AutomationId="StartButton"/>
            <Button Content="キャンセル" Padding="12,4" Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="CancelButton"/>
        </StackPanel>

        <!-- 進捗表示 -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Height="20" Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercentage, Mode=OneWay}"
                         AutomationProperties.AutomationId="ProgressBar"/>
            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="8,0,0,0"
                       AutomationProperties.AutomationId="ProgressText"/>
        </Grid>

        <TextBlock Grid.Row="5" Text="{Binding ResultSummaryText}" TextWrapping="Wrap" VerticalAlignment="Top"
                   AutomationProperties.AutomationId="ResultSummaryText"/>
    </Grid>
</Window>
