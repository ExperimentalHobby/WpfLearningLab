<Window x:Class="ReactiveSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="リアクティブ検索" Height="420" Width="480">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="検索(予約語 admin/root/test は使用不可):" Margin="0,0,0,4" />
        <TextBox Grid.Row="1" x:Name="SearchTextBox" AutomationProperties.AutomationId="SearchTextBox"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" x:Name="StatusTextBlock" AutomationProperties.AutomationId="StatusTextBlock"
                   Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                            <Setter Property="Text" Value="検索中..." />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="3" x:Name="ErrorTextBlock" AutomationProperties.AutomationId="ErrorTextBlock"
                   Foreground="Red" Margin="0,4,0,8" Text="{Binding ErrorMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="4">
            <ListBox x:Name="ResultsListBox" AutomationProperties.AutomationId="ResultsListBox"
                     ItemsSource="{Binding SearchResults}" />
            <TextBlock x:Name="NoResultsTextBlock" AutomationProperties.AutomationId="NoResultsTextBlock"
                       Text="該当する候補がありません。" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoResults}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
