<Window x:Class="NetworkMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkMonitor"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="ネットワーク帯域モニター" Height="500" Width="700">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- インターフェース選択・監視操作 -->
        <GroupBox Grid.Row="0" Header="監視対象" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="インターフェース:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding NetworkInterfaces}"
                          SelectedItem="{Binding SelectedInterface}"
                          AutomationProperties.AutomationId="InterfaceComboBox"/>
                <Button Grid.Column="2" Content="監視開始" Padding="10,4" Margin="0,0,8,0"
                        Command="{Binding StartMonitoringCommand}"
                        AutomationProperties.AutomationId="StartMonitoringButton"/>
                <Button Grid.Column="3" Content="監視停止" Padding="10,4"
                        Command="{Binding StopMonitoringCommand}"
                        AutomationProperties.AutomationId="StopMonitoringButton"/>
            </Grid>
        </GroupBox>

        <!-- グラフ表示 -->
        <oxy:PlotView Grid.Row="1" Model="{Binding PlotModel}"
                      AutomationProperties.AutomationId="BandwidthPlotView"/>
    </Grid>
</Window>
