<Window x:Class="InvoicePrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="請求書プレビュー・印刷" Height="600" Width="900">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="顧客名" Margin="0,0,0,4" />
            <TextBox Grid.Row="1" x:Name="CustomerNameTextBox" AutomationProperties.AutomationId="CustomerNameTextBox" Margin="0,0,0,8" />

            <DataGrid Grid.Row="2" x:Name="LinesDataGrid" AutomationProperties.AutomationId="LinesDataGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="品目" Binding="{Binding ItemName}" Width="120" />
                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60" />
                    <DataGridTextColumn Header="単価" Binding="{Binding UnitPrice}" Width="80" />
                    <DataGridTextColumn Header="金額" Binding="{Binding Amount, StringFormat={}{0:C0}, ConverterCulture=ja-JP}" Width="90" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="AddLineButton" AutomationProperties.AutomationId="AddLineButton" Content="行追加" Width="70" Click="AddLineButton_Click" />
                <Button x:Name="RemoveLineButton" AutomationProperties.AutomationId="RemoveLineButton" Content="行削除" Width="70" Margin="8,0,0,0" Click="RemoveLineButton_Click" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Button x:Name="PreviewButton" AutomationProperties.AutomationId="PreviewButton" Content="プレビュー更新" Width="100" Click="PreviewButton_Click" />
                <Button x:Name="PrintButton" AutomationProperties.AutomationId="PrintButton" Content="印刷" Width="70" Margin="8,0,0,0" Click="PrintButton_Click" />
                <Button x:Name="ExportXpsButton" AutomationProperties.AutomationId="ExportXpsButton" Content="XPS保存" Width="80" Margin="8,0,0,0" Click="ExportXpsButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1">
            <FlowDocumentPageViewer x:Name="PreviewViewer" AutomationProperties.AutomationId="PreviewViewer" />
        </Border>
    </Grid>
</Window>
