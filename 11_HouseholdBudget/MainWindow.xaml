<Window x:Class="HouseholdBudget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HouseholdBudget"
        xmlns:conv="clr-namespace:HouseholdBudget.Converters"
        mc:Ignorable="d"
        Title="家計簿" Height="560" Width="800">
    <Window.Resources>
        <conv:TransactionTypeToJapaneseConverter x:Key="TransactionTypeToJapaneseConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 収支サマリー -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="12" Margin="0,0,0,8" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="収入合計: " FontSize="14"/>
                <TextBlock Text="{Binding TotalIncome, StringFormat={}{0:N0}円}" FontSize="14" FontWeight="Bold"
                           Foreground="#2E7D32" Margin="0,0,24,0"
                           AutomationProperties.AutomationId="TotalIncomeText"/>
                <TextBlock Text="支出合計: " FontSize="14"/>
                <TextBlock Text="{Binding TotalExpense, StringFormat={}{0:N0}円}" FontSize="14" FontWeight="Bold"
                           Foreground="#C62828" Margin="0,0,24,0"
                           AutomationProperties.AutomationId="TotalExpenseText"/>
                <TextBlock Text="差引残高: " FontSize="14"/>
                <TextBlock Text="{Binding Balance, StringFormat={}{0:N0}円}" FontSize="14" FontWeight="Bold"
                           AutomationProperties.AutomationId="BalanceText"/>
            </StackPanel>
        </Border>

        <!-- 一覧 + カテゴリ別集計 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="TransactionsDataGrid" Grid.Column="0" Margin="0,0,8,0"
                      ItemsSource="{Binding Transactions}"
                      SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      AutomationProperties.AutomationId="TransactionsDataGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日付" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="100"/>
                    <DataGridTextColumn Header="種別" Binding="{Binding Type, Converter={StaticResource TransactionTypeToJapaneseConverter}}" Width="60"/>
                    <DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="金額" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="90"/>
                    <DataGridTextColumn Header="メモ" Binding="{Binding Memo}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Background="#F5F5F5" Padding="8" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="カテゴリ別集計" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding CategorySummary}"
                                  AutomationProperties.AutomationId="CategorySummaryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Category}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:N0}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 入力フォーム -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0" Width="130" Margin="0,0,8,0"
                        SelectedDate="{Binding InputDate}"
                        AutomationProperties.AutomationId="InputDatePicker"/>

            <ComboBox Grid.Column="1" Width="70" Margin="0,0,8,0"
                      ItemsSource="{Binding TransactionTypeOptions}"
                      SelectedItem="{Binding InputType}"
                      AutomationProperties.AutomationId="InputTypeComboBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource TransactionTypeToJapaneseConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Column="2" Margin="0,0,8,0" VerticalContentAlignment="Center"
                     Text="{Binding InputCategory, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="InputCategoryTextBox"/>

            <TextBox Grid.Column="3" Margin="0,0,8,0" VerticalContentAlignment="Center"
                     Text="{Binding InputAmount, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="InputAmountTextBox"/>

            <TextBox Grid.Column="4" Margin="0,0,8,0" VerticalContentAlignment="Center"
                     Text="{Binding InputMemo, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="InputMemoTextBox"/>

            <Button Grid.Column="5" Content="追加" Padding="12,4" Margin="0,0,8,0"
                    Command="{Binding AddCommand}"
                    AutomationProperties.AutomationId="AddButton"/>

            <Button Grid.Column="6" Content="削除" Padding="12,4"
                    Command="{Binding DeleteCommand}"
                    AutomationProperties.AutomationId="DeleteButton"/>
        </Grid>
    </Grid>
</Window>
