<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        xmlns:conv="clr-namespace:PasswordManager.Converters"
        mc:Ignorable="d"
        Title="パスワード管理" Height="600" Width="820">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <Style x:Key="ErrorMessageStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PasswordVisibleTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PasswordMaskedTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">

        <!-- ロック画面 -->
        <StackPanel Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
            <TextBlock Text="初回セットアップ: マスターパスワードを設定してください" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding IsFirstRun, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="マスターパスワードを入力してください" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding IsFirstRun, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <PasswordBox x:Name="MasterPasswordBox" Margin="0,0,0,8"
                         AutomationProperties.AutomationId="MasterPasswordBox"/>

            <TextBlock Text="確認のため、もう一度入力してください" TextWrapping="Wrap" Margin="0,0,0,4"
                       Visibility="{Binding IsFirstRun, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <PasswordBox x:Name="MasterPasswordConfirmBox" Margin="0,0,0,8"
                         Visibility="{Binding IsFirstRun, Converter={StaticResource BooleanToVisibilityConverter}}"
                         AutomationProperties.AutomationId="MasterPasswordConfirmBox"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"
                       Style="{StaticResource ErrorMessageStyle}"
                       AutomationProperties.AutomationId="ErrorMessageText"/>

            <Button Content="設定" Padding="12,4" Command="{Binding UnlockCommand}"
                    Visibility="{Binding IsFirstRun, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="SetupButton"/>
            <Button Content="ロック解除" Padding="12,4" Command="{Binding UnlockCommand}"
                    Visibility="{Binding IsFirstRun, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="UnlockButton"/>
        </StackPanel>

        <!-- 解除後画面(一覧+入力フォーム) -->
        <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" x:Name="EntriesListBox" Margin="0,0,0,8"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      AutomationProperties.AutomationId="EntriesListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Site}" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="SiteText"/>
                            <TextBlock Grid.Column="1" Text="{Binding Username}" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="UsernameText"/>

                            <TextBlock Grid.Column="2" Text="{Binding Password}" VerticalAlignment="Center"
                                       Style="{StaticResource PasswordVisibleTextStyle}"
                                       AutomationProperties.AutomationId="PasswordVisibleText"/>
                            <TextBlock Grid.Column="2" Text="••••••••" VerticalAlignment="Center"
                                       Style="{StaticResource PasswordMaskedTextStyle}"
                                       AutomationProperties.AutomationId="PasswordMaskedText"/>

                            <ToggleButton Grid.Column="3" Content="表示/非表示" Margin="4,0" Padding="6,2"
                                          IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="TogglePasswordVisibilityButton"/>
                            <Button Grid.Column="4" Content="コピー" Padding="6,2"
                                    Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.AutomationId="CopyButton"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 入力フォーム(追加/編集共通。一覧で選択すると内容が反映される) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         Text="{Binding InputSite, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="InputSiteTextBox"/>
                <TextBox Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         Text="{Binding InputUsername, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="InputUsernameTextBox"/>
                <PasswordBox Grid.Column="2" x:Name="InputPasswordBox" Margin="0,0,8,0"
                             AutomationProperties.AutomationId="InputPasswordBox"/>

                <Button Grid.Column="3" Content="追加" Padding="12,4" Margin="0,0,8,0"
                        Command="{Binding AddCommand}"
                        AutomationProperties.AutomationId="AddButton"/>
                <Button Grid.Column="4" Content="更新" Padding="12,4" Margin="0,0,8,0"
                        Command="{Binding UpdateCommand}"
                        AutomationProperties.AutomationId="UpdateButton"/>
                <Button Grid.Column="5" Content="削除" Padding="12,4"
                        Command="{Binding DeleteCommand}"
                        AutomationProperties.AutomationId="DeleteButton"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
