<Window x:Class="HabitTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabitTracker"
        xmlns:conv="clr-namespace:HabitTracker.Converters"
        mc:Ignorable="d"
        Title="習慣トラッカー" Height="640" Width="700">
    <Window.Resources>
        <conv:RateToHeightConverter x:Key="RateToHeightConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- 習慣追加 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                     Text="{Binding InputHabitName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="InputHabitNameTextBox"/>
            <Button Grid.Column="1" Content="追加" Padding="12,4"
                    Command="{Binding AddHabitCommand}"
                    AutomationProperties.AutomationId="AddHabitButton"/>
        </Grid>

        <!-- 習慣一覧 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Habits}"
                  AutomationProperties.AutomationId="HabitsListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Bold"
                                   AutomationProperties.AutomationId="HabitNameText"/>
                        <CheckBox Grid.Column="1" Content="今日実施" VerticalAlignment="Center" Margin="0,0,12,0"
                                  IsChecked="{Binding IsCompletedToday, Mode=OneWay}"
                                  Command="{Binding DataContext.ToggleTodayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.AutomationId="TodayCheckBox"/>
                        <TextBlock Grid.Column="2" Text="{Binding RecentRate, StringFormat={}直近14日: {0:P0}}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="HabitRateText"/>
                        <Button Grid.Column="3" Content="削除" Padding="6,2"
                                Command="{Binding DataContext.DeleteHabitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="DeleteHabitButton"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="直近14日間の達成率推移(全習慣平均)" FontWeight="Bold" Margin="0,8,0,4"/>

        <!-- 簡易棒グラフ -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DailySeries}" AutomationProperties.AutomationId="DailySeriesChart">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="34" Margin="2,0">
                            <TextBlock Text="{Binding Rate, StringFormat={}{0:P0}}" FontSize="9" HorizontalAlignment="Center"
                                       AutomationProperties.AutomationId="DailyRateText"/>
                            <Grid Height="{x:Static conv:RateToHeightConverter.MaxHeight}">
                                <Border Height="{Binding Rate, Converter={StaticResource RateToHeightConverter}}"
                                        Background="#1976D2" VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="DailyBar"/>
                            </Grid>
                            <TextBlock Text="{Binding Date, StringFormat={}{0:MM/dd}}" FontSize="9" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
