<Window x:Class="DataWorkbench.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="CSVデータブラウザ" Height="520" Width="820">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
			<Button x:Name="OpenButton" AutomationProperties.AutomationId="OpenButton" Content="開く" Width="80" Click="OpenButton_Click" />
			<Button x:Name="ExportButton" AutomationProperties.AutomationId="ExportButton" Content="エクスポート" Width="90" Margin="8,0,0,0" Click="ExportButton_Click" />

			<TextBlock Text="検索:" VerticalAlignment="Center" Margin="16,0,4,0" />
			<TextBox x:Name="SearchTextBox" AutomationProperties.AutomationId="SearchTextBox" Width="160" TextChanged="SearchTextBox_TextChanged" />

			<TextBlock Text="グループ化:" VerticalAlignment="Center" Margin="16,0,4,0" />
			<ComboBox x:Name="GroupByComboBox" AutomationProperties.AutomationId="GroupByComboBox" Width="140" SelectionChanged="GroupByComboBox_SelectionChanged" />
		</StackPanel>

		<DataGrid Grid.Row="1" x:Name="RowsDataGrid" AutomationProperties.AutomationId="RowsDataGrid"
				  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
				  VirtualizingPanel.IsVirtualizing="False">
			<DataGrid.GroupStyle>
				<GroupStyle>
					<GroupStyle.ContainerStyle>
						<Style TargetType="{x:Type GroupItem}">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="{x:Type GroupItem}">
										<Expander IsExpanded="True" Background="LightGray" Padding="4">
											<Expander.Header>
												<TextBlock Text="{Binding Name}" FontWeight="Bold" />
											</Expander.Header>
											<ItemsPresenter />
										</Expander>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</GroupStyle.ContainerStyle>
				</GroupStyle>
			</DataGrid.GroupStyle>
		</DataGrid>

		<TextBlock Grid.Row="2" x:Name="StatusTextBlock" AutomationProperties.AutomationId="StatusTextBlock" Margin="0,8,0,0" />
	</Grid>
</Window>
