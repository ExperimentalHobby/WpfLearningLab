<Window x:Class="ToDoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoList"
        mc:Ignorable="d"
        Title="ToDoリスト" Height="480" Width="360">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTaskTextBox" Grid.Column="0" FontSize="16" Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     AutomationProperties.AutomationId="NewTaskTextBox"/>
            <Button x:Name="AddButton" Grid.Column="1" Content="追加" Padding="12,4"
                    Click="AddButton_Click"
                    AutomationProperties.AutomationId="AddButton"/>
        </Grid>

        <ListBox x:Name="TaskListBox" Grid.Row="1"
                 SelectionChanged="TaskListBox_SelectionChanged"
                 AutomationProperties.AutomationId="TaskListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                                  Tag="{Binding Id}"
                                  Click="DoneCheckBox_Click"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="EditTaskTextBox" Grid.Column="0" FontSize="16" Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     AutomationProperties.AutomationId="EditTaskTextBox"/>
            <Button x:Name="UpdateButton" Grid.Column="1" Content="更新" Padding="12,4" Margin="0,0,8,0"
                    Click="UpdateButton_Click"
                    AutomationProperties.AutomationId="UpdateButton"/>
            <Button x:Name="DeleteButton" Grid.Column="2" Content="削除" Padding="12,4"
                    Click="DeleteButton_Click"
                    AutomationProperties.AutomationId="DeleteButton"/>
        </Grid>
    </Grid>
</Window>
