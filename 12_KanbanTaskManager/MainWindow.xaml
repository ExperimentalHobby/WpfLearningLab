<Window x:Class="KanbanTaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KanbanTaskManager"
        xmlns:behaviors="clr-namespace:KanbanTaskManager.Behaviors"
        mc:Ignorable="d"
        Title="タスク管理" Height="600" Width="900">
    <Window.Resources>
        <DataTemplate x:Key="TaskCardTemplate">
            <Border Background="White" Margin="0,0,0,6" Padding="8" CornerRadius="4"
                    BorderBrush="#DDDDDD" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="×" Padding="6,0" VerticalAlignment="Center"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}"
                            CommandParameter="{Binding}"
                            AutomationProperties.AutomationId="DeleteTaskButton"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 未着手 -->
        <Border Grid.Column="0" Background="#F5F5F5" Padding="8" Margin="0,0,8,0" CornerRadius="4"
                behaviors:DragDropBehavior.DropCommand="{Binding MoveTaskCommand}"
                behaviors:DragDropBehavior.DropTargetStatus="Todo"
                AutomationProperties.AutomationId="TodoColumnDropTarget">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="{Binding TodoColumn.Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,4,0" VerticalContentAlignment="Center"
                              Text="{Binding TodoColumn.NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.AutomationId="TodoNewTaskTextBox"/>
                    <Button Grid.Column="1" Content="追加" Padding="10,4"
                            Command="{Binding TodoColumn.AddCommand}"
                            AutomationProperties.AutomationId="TodoAddButton"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TodoColumn.Tasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}"
                                  Tag="{Binding TodoColumn.DeleteCommand}"
                                  behaviors:DragDropBehavior.IsDragSource="True"
                                  AutomationProperties.AutomationId="TodoTasksList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 対応中 -->
        <Border Grid.Column="1" Background="#F5F5F5" Padding="8" Margin="0,0,8,0" CornerRadius="4"
                behaviors:DragDropBehavior.DropCommand="{Binding MoveTaskCommand}"
                behaviors:DragDropBehavior.DropTargetStatus="InProgress"
                AutomationProperties.AutomationId="InProgressColumnDropTarget">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="{Binding InProgressColumn.Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <!-- 対応中列は未着手からのドラッグでのみタスクが増える想定のため、新規追加の入力欄は置かない -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InProgressColumn.Tasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}"
                                  Tag="{Binding InProgressColumn.DeleteCommand}"
                                  behaviors:DragDropBehavior.IsDragSource="True"
                                  AutomationProperties.AutomationId="InProgressTasksList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 完了 -->
        <Border Grid.Column="2" Background="#F5F5F5" Padding="8" CornerRadius="4"
                behaviors:DragDropBehavior.DropCommand="{Binding MoveTaskCommand}"
                behaviors:DragDropBehavior.DropTargetStatus="Done"
                AutomationProperties.AutomationId="DoneColumnDropTarget">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="{Binding DoneColumn.Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <!-- 完了列は対応中からのドラッグでのみタスクが増える想定のため、新規追加の入力欄は置かない -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DoneColumn.Tasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}"
                                  Tag="{Binding DoneColumn.DeleteCommand}"
                                  behaviors:DragDropBehavior.IsDragSource="True"
                                  AutomationProperties.AutomationId="DoneTasksList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
