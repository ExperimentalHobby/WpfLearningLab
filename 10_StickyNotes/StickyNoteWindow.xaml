<Window x:Class="StickyNotes.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickyNotes"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Width="220" Height="220"
        Title="付箋">
    <Border x:Name="RootBorder" Background="#FFF9C4" BorderBrush="#33000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="#11000000" Height="26"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Button x:Name="YellowColorButton" Width="14" Height="14" Margin="2,0" Background="#FFF9C4"
                            BorderThickness="1" BorderBrush="#55000000" Click="ColorButton_Click" Tag="#FFF9C4"
                            AutomationProperties.AutomationId="YellowColorButton"/>
                    <Button x:Name="BlueColorButton" Width="14" Height="14" Margin="2,0" Background="#B3E5FC"
                            BorderThickness="1" BorderBrush="#55000000" Click="ColorButton_Click" Tag="#B3E5FC"
                            AutomationProperties.AutomationId="BlueColorButton"/>
                    <Button x:Name="PinkColorButton" Width="14" Height="14" Margin="2,0" Background="#F8BBD0"
                            BorderThickness="1" BorderBrush="#55000000" Click="ColorButton_Click" Tag="#F8BBD0"
                            AutomationProperties.AutomationId="PinkColorButton"/>
                    <Button x:Name="GreenColorButton" Width="14" Height="14" Margin="2,0" Background="#C8E6C9"
                            BorderThickness="1" BorderBrush="#55000000" Click="ColorButton_Click" Tag="#C8E6C9"
                            AutomationProperties.AutomationId="GreenColorButton"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="CloseButton" Content="×" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0" FontSize="14"
                        Click="CloseButton_Click"
                        AutomationProperties.AutomationId="CloseButton"/>
            </Grid>

            <TextBox Grid.Row="1" x:Name="ContentTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                     Background="Transparent" BorderThickness="0" Padding="8" FontSize="14"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="ContentTextBox"/>
        </Grid>
    </Border>
</Window>
