<Window x:Class="CountdownTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CountdownTimer"
        mc:Ignorable="d"
        Title="カウントダウンタイマー" Height="300" Width="360" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="時" HorizontalAlignment="Center"/>
                <TextBox x:Name="HourTextBox" Width="50" Text="0" TextAlignment="Center" FontSize="18"
                         AutomationProperties.AutomationId="HourTextBox"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="分" HorizontalAlignment="Center"/>
                <TextBox x:Name="MinuteTextBox" Width="50" Text="0" TextAlignment="Center" FontSize="18"
                         AutomationProperties.AutomationId="MinuteTextBox"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="秒" HorizontalAlignment="Center"/>
                <TextBox x:Name="SecondTextBox" Width="50" Text="10" TextAlignment="Center" FontSize="18"
                         AutomationProperties.AutomationId="SecondTextBox"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="TimeDisplayTextBlock" Text="00:00:00" FontSize="40" FontWeight="Bold"
                   FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,16"
                   AutomationProperties.AutomationId="TimeDisplayTextBlock"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="StartButton" Content="スタート" Padding="16,6" Margin="0,0,8,0" Click="StartButton_Click"
                    AutomationProperties.AutomationId="StartButton"/>
            <Button x:Name="PauseButton" Content="一時停止" Padding="16,6" Margin="0,0,8,0" Click="PauseButton_Click"
                    AutomationProperties.AutomationId="PauseButton"/>
            <Button x:Name="ResetButton" Content="リセット" Padding="16,6" Click="ResetButton_Click"
                    AutomationProperties.AutomationId="ResetButton"/>
        </StackPanel>
    </Grid>
</Window>
