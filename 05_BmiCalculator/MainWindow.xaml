<Window x:Class="BmiCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BmiCalculator"
        mc:Ignorable="d"
        Title="BMI計算機" Height="360" Width="360" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ValidatedTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16" Validation.Error="RootGrid_ValidationError">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="身長 (cm)" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="HeightTextBox" Style="{StaticResource ValidatedTextBoxStyle}"
                     AutomationProperties.AutomationId="HeightTextBox">
                <TextBox.Text>
                    <Binding Path="HeightInput" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                        <Binding.ValidationRules>
                            <local:NumericRangeValidationRule Min="50" Max="250" FieldName="身長"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="体重 (kg)" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="WeightTextBox" Style="{StaticResource ValidatedTextBoxStyle}"
                     AutomationProperties.AutomationId="WeightTextBox">
                <TextBox.Text>
                    <Binding Path="WeightInput" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                        <Binding.ValidationRules>
                            <local:NumericRangeValidationRule Min="10" Max="300" FieldName="体重"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>

        <Button Grid.Row="2" x:Name="CalculateButton" Content="計算" Click="CalculateButton_Click"
                Padding="16,6" HorizontalAlignment="Left" Margin="0,0,0,16"
                AutomationProperties.AutomationId="CalculateButton"/>

        <StackPanel Grid.Row="3">
            <TextBlock x:Name="BmiValueTextBlock" FontSize="20" FontWeight="Bold"
                       AutomationProperties.AutomationId="BmiValueTextBlock"/>
            <TextBlock x:Name="JudgmentTextBlock" FontSize="18" Margin="0,4,0,0"
                       AutomationProperties.AutomationId="JudgmentTextBlock">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Tag" Value="低体重">
                                <Setter Property="Foreground" Value="Blue"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="普通体重">
                                <Setter Property="Foreground" Value="Green"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="肥満">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
