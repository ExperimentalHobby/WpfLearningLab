<Window x:Class="SystemTrayUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemTrayUtility"
        mc:Ignorable="d"
        Title="システムトレイ常駐ユーティリティ" Height="360" Width="480">
    <StackPanel Margin="16">
        <TextBlock Text="このウィンドウを閉じてもアプリはタスクトレイに常駐し続けます。トレイアイコンを右クリックすると「開く」「今すぐ通知」「終了」を選べます。"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <GroupBox Header="定期リマインダー" Margin="0,0,0,16">
            <StackPanel Margin="8">
                <CheckBox Content="定期リマインダーを有効にする" IsChecked="{Binding IsReminderEnabled}" Margin="0,0,0,8"
                          AutomationProperties.AutomationId="ReminderEnabledCheckBox"/>
                <TextBlock Text="間隔(分):"/>
                <TextBox Text="{Binding ReminderIntervalInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                          AutomationProperties.AutomationId="ReminderIntervalTextBox"/>
                <TextBlock Text="メッセージ:"/>
                <TextBox Text="{Binding ReminderMessage, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.AutomationId="ReminderMessageTextBox"/>
            </StackPanel>
        </GroupBox>

        <CheckBox Content="Windows起動時に自動起動する" IsChecked="{Binding IsStartupEnabled}" Margin="0,0,0,16"
                  AutomationProperties.AutomationId="StartupEnabledCheckBox"/>

        <Button Content="テスト通知を表示" Command="{Binding TestNotifyCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,16"
                AutomationProperties.AutomationId="TestNotifyButton"/>

        <TextBlock Text="{Binding StatusText}" Foreground="Gray" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="StatusText"/>
    </StackPanel>
</Window>
