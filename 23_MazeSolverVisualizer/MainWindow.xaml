<Window x:Class="MazeSolverVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MazeSolverVisualizer"
        mc:Ignorable="d"
        Title="迷路生成&amp;探索ビジュアライザ" Height="640" Width="560">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="迷路生成" Padding="8,4" Margin="0,0,16,0"
                    Command="{Binding GenerateCommand}"
                    AutomationProperties.AutomationId="GenerateButton"/>

            <TextBlock Text="アルゴリズム:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox Width="140" Margin="0,0,16,0"
                      ItemsSource="{Binding Solvers}"
                      SelectedItem="{Binding SelectedSolver}"
                      DisplayMemberPath="Name"
                      AutomationProperties.AutomationId="SolverComboBox"/>

            <Button Content="探索実行" Padding="8,4"
                    Command="{Binding SolveCommand}"
                    AutomationProperties.AutomationId="SolveButton"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="White">
            <Canvas x:Name="GridCanvas"
                    AutomationProperties.AutomationId="GridCanvas"/>
        </Border>
    </Grid>
</Window>
