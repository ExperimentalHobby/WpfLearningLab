<Window x:Class="BehaviorGallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:BehaviorGallery"
        xmlns:ap="clr-namespace:BehaviorGallery.AttachedProperties"
        xmlns:b="clr-namespace:BehaviorGallery.Behaviors"
        Title="添付ビヘイビアギャラリー" Height="520" Width="560">
    <StackPanel Margin="16">

        <TextBlock Text="1. 添付プロパティ: プレースホルダー表示" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="PlaceholderService.Text を設定した TextBox。未入力の間だけ薄字で文言が表示される。" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBox x:Name="PlaceholderTextBox" AutomationProperties.AutomationId="PlaceholderTextBox"
                 ap:PlaceholderService.Text="氏名を入力してください" Width="240" HorizontalAlignment="Left" />

        <Separator Margin="0,16" />

        <TextBlock Text="2. Behavior: Enterキーでコマンド実行" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="EnterKeyCommandBehavior をアタッチしたTextBoxで、Enterキー押下時にコマンドが実行される。" TextWrapping="Wrap" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="EnterKeyTextBox" AutomationProperties.AutomationId="EnterKeyTextBox" Width="200">
                <i:Interaction.Behaviors>
                    <b:EnterKeyCommandBehavior Command="{Binding SubmitCommand}" />
                </i:Interaction.Behaviors>
            </TextBox>
        </StackPanel>
        <TextBlock x:Name="SubmitResultTextBlock" AutomationProperties.AutomationId="SubmitResultTextBlock" Margin="0,8,0,0" Foreground="Blue" />

        <Separator Margin="0,16" />

        <TextBlock Text="3. Behavior: ドラッグで移動" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="DragMoveBehavior をアタッチした矩形をCanvas内でドラッグして移動できる。" TextWrapping="Wrap" Margin="0,0,0,4" />
        <Canvas Height="140" Background="#F5F5F5">
            <Border x:Name="DraggableBorder" AutomationProperties.AutomationId="DraggableBorder"
                    Width="100" Height="60" Background="#2563EB" Canvas.Left="20" Canvas.Top="20">
                <i:Interaction.Behaviors>
                    <b:DragMoveBehavior />
                </i:Interaction.Behaviors>
                <TextBlock Text="ドラッグ" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Border>
        </Canvas>
    </StackPanel>
</Window>
