<Window x:Class="ThemeAndLocaleApp.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:ThemeAndLocaleApp"
		Title="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[AppTitle]}"
		Height="360" Width="520"
		Background="{DynamicResource WindowBackgroundBrush}">
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
			<TextBlock Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ThemeLabel]}"
					   Foreground="{DynamicResource WindowForegroundBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
			<Button x:Name="LightThemeButton" AutomationProperties.AutomationId="LightThemeButton"
					Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[LightThemeButton]}"
					Width="80" Click="LightThemeButton_Click" />
			<Button x:Name="DarkThemeButton" AutomationProperties.AutomationId="DarkThemeButton"
					Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[DarkThemeButton]}"
					Width="80" Margin="8,0,0,0" Click="DarkThemeButton_Click" />
		</StackPanel>

		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
			<TextBlock Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[LanguageLabel]}"
					   Foreground="{DynamicResource WindowForegroundBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
			<Button x:Name="JapaneseButton" AutomationProperties.AutomationId="JapaneseButton" Content="日本語" Width="80" Click="JapaneseButton_Click" />
			<Button x:Name="EnglishButton" AutomationProperties.AutomationId="EnglishButton" Content="English" Width="80" Margin="8,0,0,0" Click="EnglishButton_Click" />
		</StackPanel>

		<TextBlock Grid.Row="2" x:Name="GreetingTextBlock" AutomationProperties.AutomationId="GreetingTextBlock"
				   Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[GreetingMessage]}"
				   FontSize="16" FontWeight="Bold"
				   Foreground="{DynamicResource WindowForegroundBrush}" Margin="0,0,0,16" />

		<TextBlock Grid.Row="3" x:Name="DynamicDemoTextBlock" AutomationProperties.AutomationId="DynamicDemoTextBlock"
				   Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[DynamicResourceDemoLabel]}"
				   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />

		<TextBlock Grid.Row="4" x:Name="StaticDemoTextBlock" AutomationProperties.AutomationId="StaticDemoTextBlock"
				   Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[StaticResourceDemoLabel]}"
				   Foreground="{StaticResource AccentBrush}" />
	</Grid>
</Window>
