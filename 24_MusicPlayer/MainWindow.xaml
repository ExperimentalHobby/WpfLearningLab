<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer"
        xmlns:conv="clr-namespace:MusicPlayer.Converters"
        mc:Ignorable="d"
        Title="ミュージックプレイヤー" Height="600" Width="640">
    <Window.Resources>
        <conv:TimeSpanToSecondsConverter x:Key="TimeSpanToSecondsConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- フォルダ読込 -->
        <Button Grid.Row="0" Content="フォルダを開く" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8"
                Command="{Binding LoadFolderCommand}"
                AutomationProperties.AutomationId="LoadFolderButton"/>

        <!-- エラー表示 -->
        <TextBlock Grid.Row="1" Margin="0,0,0,8" Foreground="#C62828" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                   AutomationProperties.AutomationId="ErrorMessageText"/>

        <!-- プレイリスト -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Playlist}"
                  SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                  AutomationProperties.AutomationId="PlaylistListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="TrackTitleText"/>
                        <Button Grid.Column="1" Content="再生" Padding="6,2" Margin="4,0"
                                Command="{Binding DataContext.SelectTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="PlayTrackButton"/>
                        <Button Grid.Column="2" Content="↑" Padding="6,2" Margin="0,0,4,0"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="MoveUpButton"/>
                        <Button Grid.Column="3" Content="↓" Padding="6,2" Margin="0,0,4,0"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="MoveDownButton"/>
                        <Button Grid.Column="4" Content="削除" Padding="6,2"
                                Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="RemoveTrackButton"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 再生コントロール -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding CurrentTrack.Title, TargetNullValue=(未再生)}" FontWeight="Bold" Margin="0,0,0,4"
                       AutomationProperties.AutomationId="CurrentTrackText"/>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Position, StringFormat={}{0:mm\\:ss}}" Margin="0,0,8,0"
                           AutomationProperties.AutomationId="PositionText"/>
                <Slider Grid.Column="1" Minimum="0"
                        Maximum="{Binding Duration, Converter={StaticResource TimeSpanToSecondsConverter}}"
                        Value="{Binding Position, Converter={StaticResource TimeSpanToSecondsConverter}, Mode=TwoWay}"
                        AutomationProperties.AutomationId="SeekSlider"/>
                <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat={}{0:mm\\:ss}}" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="DurationText"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="前へ" Padding="8,4" Margin="0,0,4,0"
                        Command="{Binding PreviousCommand}"
                        AutomationProperties.AutomationId="PreviousButton"/>
                <Button Content="再生/一時停止" Padding="8,4" Margin="0,0,4,0"
                        Command="{Binding PlayPauseCommand}"
                        AutomationProperties.AutomationId="PlayPauseButton"/>
                <Button Content="停止" Padding="8,4" Margin="0,0,4,0"
                        Command="{Binding StopCommand}"
                        AutomationProperties.AutomationId="StopButton"/>
                <Button Content="次へ" Padding="8,4" Margin="0,0,16,0"
                        Command="{Binding NextCommand}"
                        AutomationProperties.AutomationId="NextButton"/>
                <ToggleButton Content="シャッフル" Padding="8,4" Margin="0,0,4,0"
                              IsChecked="{Binding IsShuffle, Mode=OneWay}"
                              Command="{Binding ToggleShuffleCommand}"
                              AutomationProperties.AutomationId="ShuffleToggleButton"/>
                <Button Padding="8,4"
                        Content="{Binding RepeatMode, StringFormat=リピート: {0}}"
                        Command="{Binding ToggleRepeatCommand}"
                        AutomationProperties.AutomationId="RepeatButton"/>
            </StackPanel>
        </StackPanel>

        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed"/>
    </Grid>
</Window>
