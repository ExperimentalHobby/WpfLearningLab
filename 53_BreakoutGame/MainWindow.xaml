<Window x:Class="BreakoutGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ブロック崩しゲーム" Height="620" Width="440"
        Focusable="True" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="スコア: " FontWeight="Bold" />
            <TextBlock x:Name="ScoreText" Text="0" AutomationProperties.AutomationId="ScoreText" Margin="0,0,16,0" />
            <TextBlock Text="ライフ: " FontWeight="Bold" />
            <TextBlock x:Name="LivesText" Text="3" AutomationProperties.AutomationId="LivesText" Margin="0,0,16,0" />
            <TextBlock x:Name="StatusText" FontWeight="Bold" Foreground="Red"
                       AutomationProperties.AutomationId="StatusText" Margin="0,0,16,0" />
            <Button Content="リスタート" Padding="8,2" Click="RestartButton_Click" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="Black">
            <Canvas x:Name="GameCanvas" ClipToBounds="True" />
        </Border>
    </Grid>
</Window>
