<Window x:Class="ClaudeChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude APIチャットクライアント" Height="560" Width="480">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ロック画面 -->
        <StackPanel x:Name="LockPanel">
            <TextBlock x:Name="LockTitleText" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />

            <StackPanel x:Name="ApiKeyInputPanel" Margin="0,0,0,8">
                <TextBlock Text="Claude APIキー(初回のみ):" />
                <PasswordBox x:Name="ApiKeyPasswordBox" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="マスターパスワード:" Margin="0,0,0,4" />
            <PasswordBox x:Name="MasterPasswordBox" />

            <Button x:Name="UnlockButton" Content="開始" Margin="0,12,0,0" Padding="8,4"
                    HorizontalAlignment="Left" Click="UnlockButton_Click" />

            <TextBlock x:Name="LockErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="LockErrorText" />
        </StackPanel>

        <!-- チャット画面 -->
        <Grid x:Name="ChatPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox x:Name="MessagesList" Grid.Row="0" Margin="0,0,0,8"
                     AutomationProperties.AutomationId="MessagesList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="ChatErrorText" Grid.Row="1" Foreground="Red" Margin="0,0,0,4" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ChatErrorText" />

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBox x:Name="InputTextBox" Width="300" Margin="0,0,8,0"
                         AutomationProperties.AutomationId="InputTextBox" />
                <Button x:Name="SendButton" Content="送信" Padding="8,4" Click="SendButton_Click" />
                <Button x:Name="CancelButton" Content="キャンセル" Padding="8,4" Margin="8,0,0,0"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
