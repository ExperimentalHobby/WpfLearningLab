<Window x:Class="LogStreamAggregator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogStreamAggregator"
        mc:Ignorable="d"
        Title="ログストリーム集計ツール" Height="560" Width="640">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="開始" Padding="12,4" Margin="0,0,8,0" Command="{Binding StartCommand}"
                    AutomationProperties.AutomationId="StartButton"/>
            <Button Content="停止" Padding="12,4" Margin="0,0,16,0" Command="{Binding StopCommand}"
                    AutomationProperties.AutomationId="StopButton"/>
            <TextBlock VerticalAlignment="Center" Text="{Binding TotalCount, StringFormat=総件数: {0}}"
                       AutomationProperties.AutomationId="TotalCountText"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="ログレベル別件数" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding CountsByLevel}" AutomationProperties.AutomationId="CountsByLevelList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Key}" FontWeight="Bold"/>
                            <TextBlock Text=": "/>
                            <TextBlock Text="{Binding Value}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="キーワード出現回数" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding KeywordCounts}" AutomationProperties.AutomationId="KeywordCountsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Key}" FontWeight="Bold"/>
                            <TextBlock Text=": "/>
                            <TextBlock Text="{Binding Value}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="直近のログ" FontWeight="Bold" Margin="0,0,0,4"/>

        <ListBox Grid.Row="4" ItemsSource="{Binding RecentLogs}" AutomationProperties.AutomationId="RecentLogsListBox"/>
    </Grid>
</Window>
