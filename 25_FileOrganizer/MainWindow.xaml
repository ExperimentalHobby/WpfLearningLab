<Window x:Class="FileOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileOrganizer"
        mc:Ignorable="d"
        Title="ファイル自動整理" Height="560" Width="640">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 監視フォルダ選択 -->
        <GroupBox Grid.Row="0" Header="監視フォルダ" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         Text="{Binding WatchFolder, Mode=OneWay}"
                         AutomationProperties.AutomationId="WatchFolderTextBox"/>
                <Button Grid.Column="1" Content="フォルダ選択..." Padding="10,4" Margin="0,0,8,0"
                        Command="{Binding SelectFolderCommand}"
                        AutomationProperties.AutomationId="SelectFolderButton"/>
                <Button Grid.Column="2" Content="監視開始" Padding="10,4" Margin="0,0,8,0"
                        Command="{Binding StartWatchingCommand}"
                        AutomationProperties.AutomationId="StartWatchingButton"/>
                <Button Grid.Column="3" Content="監視停止" Padding="10,4"
                        Command="{Binding StopWatchingCommand}"
                        AutomationProperties.AutomationId="StopWatchingButton"/>
            </Grid>
        </GroupBox>

        <!-- 振り分けルール -->
        <GroupBox Grid.Row="1" Header="振り分けルール" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="拡張子:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding NewRuleExtension, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="NewRuleExtensionTextBox"/>
                    <TextBlock Grid.Column="2" Text="移動先フォルダ名:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="3" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding NewRuleDestination, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="NewRuleDestinationTextBox"/>
                    <Button Grid.Column="4" Content="ルール追加" Padding="10,4"
                            Command="{Binding AddRuleCommand}"
                            AutomationProperties.AutomationId="AddRuleButton"/>
                </Grid>
                <ListBox ItemsSource="{Binding Rules}" MaxHeight="120"
                         AutomationProperties.AutomationId="RulesListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{Binding Extension, StringFormat={}{0} →}"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Text="{Binding DestinationFolderName}"/>
                                <Button Grid.Column="2" Content="削除" Padding="8,2"
                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="RemoveRuleButton"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </GroupBox>

        <!-- 一括整理 -->
        <Button Grid.Row="2" Content="既存ファイルを一括整理" Padding="10,4" Margin="0,0,0,8"
                HorizontalAlignment="Left"
                Command="{Binding OrganizeExistingCommand}"
                AutomationProperties.AutomationId="OrganizeExistingButton"/>

        <TextBlock Grid.Row="3" Text="処理ログ" FontWeight="Bold" Margin="0,0,0,4"/>

        <!-- 処理ログ -->
        <ListBox Grid.Row="4" ItemsSource="{Binding Logs}"
                  AutomationProperties.AutomationId="LogsListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="Gray" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SourcePath}"/>
                        <TextBlock Text=" → " Visibility="{Binding Moved, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding DestinationPath}" Visibility="{Binding Moved, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="8,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
